# Apimart gpt-image-2 (async task model — see CLAUDE.md §7)
APIMART_BASE_URL=https://api.apimart.ai
APIMART_API_KEY=sk-replace-with-real-key

# Database (default writes to ./data/posterforge.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/posterforge.db

# Session (cookie signing). Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=change-me-32-or-more-random-chars
SESSION_MAX_AGE_SECONDS=2592000

# Admins (CSV of work_id; empty = no admin yet)
ADMIN_WORK_IDS=

# Admin elevation (required for /api/admin/*)
# Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_ELEVATION_SECRET=

# Agent LLM Model (defaults to gpt-5.4)
AGENT_LLM_MODEL=gemini-2.5-flash
