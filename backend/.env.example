# Tencent Cloud gpt-image-2 (VOD API)
TENCENTCLOUD_SECRET_ID=AKID-replace-with-real-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-real-secret-key
TENCENTCLOUD_SUB_APP_ID=
TENCENTCLOUD_REGION=ap-guangzhou

# Database (default writes to ./data/posterforge.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/posterforge.db

# Session (cookie signing). Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=change-me-32-or-more-random-chars
SESSION_MAX_AGE_SECONDS=2592000

# Admins (CSV of work_id; empty = no admin yet)
ADMIN_WORK_IDS=

# Admin elevation (required for /api/admin/*)
# Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_ELEVATION_SECRET=

# Agent LLM Model (apimart)
AGENT_LLM_KEY=sk-replace-with-real-key
AGENT_LLM_BASE=https://api.apimart.ai/v1
AGENT_LLM_MODEL=gemini-3.5-flash-lite
